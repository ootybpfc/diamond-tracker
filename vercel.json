{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/transcribe.ts": {
      "maxDuration": 60
    },
    "api/polish-content.ts": {
      "maxDuration": 15
    },
    "api/extract-actions.ts": {
      "maxDuration": 15
    }
  }
}
